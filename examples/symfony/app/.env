# The application runs in a browser, in the page of ../public/: nothing here
# is a secret.
APP_ENV=prod
APP_SECRET=it-runs-in-a-browser-it-is-not-a-secret

# /symfony is kept in IndexedDB by the page, keep in sync with persist in
# ../public/index.html
DATABASE_URL="sqlite:////symfony/guestbook.sqlite"
