{% extends 'base.html.twig' %}

{% block body %}
    <h1>Guestbook</h1>

    {% for message in app.flashes('success') %}
        <p class="flash">{{ message }}</p>
    {% endfor %}

    {{ form(form) }}

    <ul>
        {% for message in messages %}
            <li>
                <b>{{ message.author }}</b>
                <time>{{ message.createdAt|date('Y-m-d H:i') }}</time>
                <p>{{ message.text }}</p>
            </li>
        {% else %}
            <li>Nobody signed yet.</li>
        {% endfor %}
    </ul>
{% endblock %}
