{% extends 'base.html.twig' %}

{% block body %}
    <h1>Guestbook</h1>

    {{ form(form) }}

    <ul>
        {% for message in messages %}
            <li>
                <a href="{{ path('message', {id: message.id}) }}"><b>{{ message.author }}</b></a>
                <time>{{ message.createdAt|date('Y-m-d H:i') }}</time>
                <p>{{ message.text }}</p>
            </li>
        {% else %}
            <li>Nobody signed yet.</li>
        {% endfor %}
    </ul>
{% endblock %}
